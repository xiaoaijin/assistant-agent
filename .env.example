# 数据库（docker compose 起的 Postgres）
DATABASE_URL=postgresql://assistant:assistant@localhost:5433/assistant

# 模型：LiteLLM 模型串，自由更换供应商，loop 不感知
# 例：deepseek/deepseek-chat、openai/gpt-4o-mini、anthropic/claude-sonnet-4-6
# 对应供应商的 key 由 LiteLLM 从环境变量读取（如 DEEPSEEK_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY）
ASSISTANT_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=

# 嵌入模型（RAG，ADR-0005）：通义 text-embedding-v3（1024 维）
EMBEDDING_MODEL=dashscope/text-embedding-v3
DASHSCOPE_API_KEY=

# 退款额度（元），库里 quotas 表会覆盖此默认值
DEFAULT_REFUND_QUOTA=100

# 管理端 token 签名密钥（生产必须更换）
ADMIN_SECRET=dev-admin-secret-change-me
